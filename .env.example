# Local Docker Compose settings. Use URL-safe characters in database and Redis passwords.
POSTGRES_DB=rental_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdevpostgres
REDIS_PASSWORD=localdevredis

PORT=7000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
UPLOAD_DIR=/app/uploads

# Browser-facing URLs (these are compiled into the frontend image).
VITE_BACKEND_URL=http://localhost:7000
VITE_FILE_URL=http://localhost:7000

# Backend authentication and mail settings.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
