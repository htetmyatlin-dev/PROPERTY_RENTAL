model Message {
  id          String    @id @default(uuid())
  chatId      String
  senderId    String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chat        Chat      @relation(fields: [chatId], references: [id])
  sender      User      @relation(fields: [senderId], references: [id])
} 
